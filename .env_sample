# PostgreSQL (optional in local development; required for persistent PostgreSQL records)
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/<DB_NAME>"
PGSSL="false"

# SMTP email delivery (Gmail App Password or your organization's SMTP credentials)

# Email configuration
MAIL_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
APPLICATION_NOTIFY_EMAIL=""

# Admin console credentials (use a strong, unique password; never commit real secrets)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Random secret of at least 32 characters for signing admin sessions
ADMIN_SESSION_SECRET="samajbhandhngoadmincredential1234"
